{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true,
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run alembic -c services/api/alembic.ini check)",
      "Bash(pnpm --filter web typecheck)",
      "Bash(pnpm --filter web test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "mcp__arch-kg__*",
      "mcp__postgres-kg__*"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(docker compose up:*)",
      "Bash(uv run alembic -c services/api/alembic.ini upgrade:*)",
      "Bash(uv run alembic -c services/api/alembic.ini downgrade:*)",
      "Edit(.github/workflows/**)",
      "Edit(.claude/settings.json)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-destructive-commands.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run pytest -q --tb=short >&2 || exit 2",
            "timeout": 120,
            "statusMessage": "pytest перед git commit…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.py) cd \"$CLAUDE_PROJECT_DIR\" && uv run ruff format -q \"$f\" && uv run ruff check -q --fix \"$f\" >/dev/null ;; esac; exit 0",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '[(now|todate), .session_id, .tool_input.command] | @tsv' >> \"$HOME/.claude/audit-bash.log\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-make-check.sh",
            "timeout": 300,
            "statusMessage": "make check перед завершенням…"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "context7",
    "linear",
    "arch-kg",
    "postgres-kg"
  ]
}

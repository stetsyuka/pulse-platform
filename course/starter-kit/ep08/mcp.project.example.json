{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.6.0"
      ]
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "arch-kg": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--python",
        "3.12",
        "--with",
        "mcp==1.30.0",
        "python",
        "./course/starter-kit/ep08/mcp-knowledge-server.example.py"
      ]
    },
    "postgres-kg": {
      "type": "stdio",
      "command": "./course/starter-kit/ep08/vault-postgres-mcp-wrapper.example.sh",
      "env": {
        "VAULT_ADDR": "${VAULT_ADDR:-https://vault.internal.example:8200}",
        "VAULT_SECRET_PATH": "secret/demo-app/database"
      }
    }
  }
}
